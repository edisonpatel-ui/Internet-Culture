# Internet Culture Hub — public environment variables
# Copy to `.env.local` for local overrides. Set the same keys in Vercel → Settings → Environment Variables.
# Never put private API keys or secrets in NEXT_PUBLIC_* variables.

# Canonical site origin (no trailing slash). Required for correct sitemap, robots, Open Graph, and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://internetculturehub.com

# Optional — Google Search Console HTML tag verification token (content= value only)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
