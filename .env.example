# Internet Culture Hub — public environment variables
# Copy to `.env.local` for local overrides. Set the same keys in Vercel → Settings → Environment Variables.
# Never put private API keys or secrets in NEXT_PUBLIC_* variables.

# Canonical site origin (no trailing slash).
# REQUIRED in production — sitemap, robots.txt, Open Graph, canonicals, and JSON-LD all use this.
# Must match the hostname users and Google see (View Source → rel="canonical").
# Current production host on Vercel:
NEXT_PUBLIC_SITE_URL=https://internet-culture.vercel.app
# When a custom domain is primary, change Production env to e.g.:
# NEXT_PUBLIC_SITE_URL=https://www.example.com
# Then redeploy and re-submit sitemap in Search Console.

# Optional override — Google Search Console HTML tag verification (content= value only).
# Default is set in lib/seo.ts; override here or in Vercel only if Google issues a new token.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=nfCTKbDePewotXPNjNQIvYR-tYHo-bJIK5akZ7_7amc

# Google Analytics 4 measurement ID (gtag.js). Loaded only when NODE_ENV=production.
# Set this in Vercel → Environment Variables for Production.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-5K2RHWRQLD

# Public contact inboxes for /contact, /privacy, /dmca (optional until domain email exists).
# NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
# NEXT_PUBLIC_DMCA_EMAIL=dmca@your-domain.com

# --- Feedback form (Resend) — server-only, never NEXT_PUBLIC_* ---
# Required for /api/feedback. Create a key at https://resend.com
# RESEND_API_KEY=re_xxxxxxxx
# Verified sender (use onboarding@resend.dev for Resend test sends, or your domain):
# RESEND_FROM_EMAIL=Internet Culture Hub <onboarding@resend.dev>
# Inbox that receives feedback (defaults to edisonpatel@gmail.com if unset):
# FEEDBACK_TO_EMAIL=edisonpatel@gmail.com

# --- Experimental Maintenance Center — live evidence providers (server-only) ---
# Optional YouTube Data API v3 key for recent video activity during refresh:
# YOUTUBE_DATA_API_KEY=AIza...
# Set to false to skip Google Trending RSS checks:
# GOOGLE_TRENDS_ENABLED=true

# --- Internal Editorial OS (server-only, never NEXT_PUBLIC_*) ---
# Shared unlock token until real auth exists. See docs/EDITORIAL_OS_SECURITY.md
# Development: leave unset to keep /research etc. open locally.
# Production: REQUIRED — without it, editorial routes return 404 (fail closed).
# EDITORIAL_OS_TOKEN=replace-with-a-long-random-secret
