{
  "openapi": "3.1.0",
  "info": {
    "title": "Culture Graph API",
    "version": "1.0.0",
    "description": "Predictive trend metrics and real-time velocity scoring for memes, slang, and internet culture.\n\nThe Culture Graph API exposes a structured intelligence profile for every tracked term: a signed **velocity score** for momentum, a **lifecycle decay index** for forecasting longevity, a **cross-platform origin timeline**, and **normalized template data** ready for programmatic use. One authenticated REST interface, one consistent JSON schema, one error format.\n\n**Authentication.** Send your API key as a bearer token: `Authorization: Bearer cg_live_…`.\n\n**Methodology.** `decayTracker`, `originMapping`, and `templateData` are computed from Internet Culture Hub's editorial scoring model and tracked-platform data. They are an analytical layer, not third-party telemetry.",
    "contact": {
      "url": "https://internet-culture.vercel.app/contact"
    }
  },
  "servers": [
    {
      "url": "https://internet-culture.vercel.app",
      "description": "Production"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "tags": [
    {
      "name": "Terms",
      "description": "Retrieve the full intelligence profile for a single term."
    },
    {
      "name": "Directory",
      "description": "Discover terms and retrieve profiles in bulk."
    }
  ],
  "paths": {
    "/api/v1/terms/{slug}": {
      "get": {
        "tags": [
          "Terms"
        ],
        "summary": "Retrieve a term's intelligence profile",
        "description": "Returns the complete profile for one term: real-time velocity score, lifecycle decay index, chronological cross-platform origin timeline, and normalized template data. Identify the term by its slug; use `GET /api/v1/terms` to discover slugs.",
        "operationId": "getTermBySlug",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "Lowercase kebab-case slug of the term, e.g. `brainrot` or `skibidi-toilet`.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 120,
              "example": "brainrot"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "headers": {
              "X-RateLimit-Limit": {
                "description": "Requests allowed per 60-second burst window for this key's tier.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Requests remaining in the current 60-second burst window.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Quota-Limit": {
                "description": "Total requests allowed this calendar month for this key's tier.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Quota-Remaining": {
                "description": "Requests remaining this calendar month.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TermResponse"
                },
                "example": {
                  "success": true,
                  "data": {
                    "term": "Brainrot",
                    "definition": "Internet slang for content so low-value or repetitive it's said to rot the viewer's brain.",
                    "category": "slang",
                    "velocityIndex": "12.5%",
                    "decayTracker": {
                      "cringeStatus": "Rising",
                      "decayIndex": 0.42
                    },
                    "originMapping": [
                      {
                        "platform": "tiktok",
                        "stage": "Origin",
                        "date": "2023-06-01"
                      },
                      {
                        "platform": "tiktok",
                        "stage": "Current",
                        "date": "2026-08-01"
                      }
                    ],
                    "templateData": {
                      "name": "slang term",
                      "status": "Established",
                      "viralPreferenceScore": 74
                    },
                    "relatedSlugs": [
                      "skibidi-toilet",
                      "gyatt"
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid slug format.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_INPUT",
                    "message": "Invalid slug in request path.",
                    "status": 400
                  },
                  "issues": [
                    {
                      "field": "slug",
                      "message": "slug must be lowercase kebab-case (letters, numbers, hyphens)"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Invalid API key.",
                    "status": 401
                  }
                }
              }
            }
          },
          "404": {
            "description": "No entry exists for that slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "NOT_FOUND",
                    "message": "No entry found for slug \"not-a-real-term\".",
                    "status": 404
                  }
                }
              }
            }
          },
          "429": {
            "description": "Burst rate limit or monthly quota exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "RATE_LIMITED",
                    "message": "Rate limit exceeded. Please slow down and try again shortly.",
                    "status": 429
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error — safe to retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Something went wrong. Please try again.",
                    "status": 500
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terms": {
      "get": {
        "tags": [
          "Directory"
        ],
        "summary": "Search and browse terms",
        "description": "Returns a paginated, filterable directory of terms as lightweight summaries. Use it to discover slugs, then retrieve full profiles with `GET /api/v1/terms/{slug}` or `POST /api/v1/terms/batch`.",
        "operationId": "listTerms",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Filter to one content category.",
            "schema": {
              "type": "string",
              "enum": [
                "meme",
                "slang",
                "trend",
                "brainrot",
                "event",
                "creator"
              ]
            }
          },
          {
            "name": "minVelocity",
            "in": "query",
            "required": false,
            "description": "Inclusive lower bound on an entry's latest recorded velocity (point change in curated relevance). Entries with no recorded velocity history are excluded when this filter is set.",
            "schema": {
              "type": "number",
              "example": 5
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Page size, 1-50.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "1-indexed page number.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response.",
            "headers": {
              "X-RateLimit-Limit": {
                "description": "Requests allowed per 60-second burst window for this key's tier.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Requests remaining in the current 60-second burst window.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Quota-Limit": {
                "description": "Total requests allowed this calendar month for this key's tier.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Quota-Remaining": {
                "description": "Requests remaining this calendar month.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TermsListResponse"
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "slug": "skibidi-toilet",
                      "term": "Skibidi Toilet",
                      "category": "brainrot",
                      "description": "A surreal animated series pitting toilet-headed creatures against camera-headed humanoids.",
                      "scores": {
                        "relevance": 78,
                        "influence": 82,
                        "cringe": 55,
                        "brainrot": 97
                      },
                      "velocity": 6.2
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "limit": 20,
                    "total": 1,
                    "totalPages": 1
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid query parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_INPUT",
                    "message": "Invalid request parameters.",
                    "status": 400
                  },
                  "issues": [
                    {
                      "field": "limit",
                      "message": "limit must be 50 or fewer"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Invalid API key.",
                    "status": 401
                  }
                }
              }
            }
          },
          "429": {
            "description": "Burst rate limit or monthly quota exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "RATE_LIMITED",
                    "message": "Rate limit exceeded. Please slow down and try again shortly.",
                    "status": 429
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error — safe to retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Something went wrong. Please try again.",
                    "status": 500
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/terms/batch": {
      "post": {
        "tags": [
          "Directory"
        ],
        "summary": "Retrieve up to 20 term profiles in one request",
        "description": "Batch equivalent of `GET /api/v1/terms/{slug}`. Returns the full intelligence profile for each requested slug in a single round trip, counted as one request against your burst limit. Accepts 1–20 slugs. An unknown slug does not fail the request; it is returned as `{ \"found\": false }` alongside the successful results.",
        "operationId": "batchGetTerms",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchTermsRequest"
              },
              "example": {
                "slugs": [
                  "brainrot",
                  "skibidi-toilet",
                  "gyatt"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response. Always 200 even if some slugs weren't found — check each item's `found` field.",
            "headers": {
              "X-RateLimit-Limit": {
                "description": "Requests allowed per 60-second burst window for this key's tier.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-RateLimit-Remaining": {
                "description": "Requests remaining in the current 60-second burst window.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Quota-Limit": {
                "description": "Total requests allowed this calendar month for this key's tier.",
                "schema": {
                  "type": "integer"
                }
              },
              "X-Quota-Remaining": {
                "description": "Requests remaining this calendar month.",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchTermsResponse"
                },
                "example": {
                  "success": true,
                  "data": [
                    {
                      "slug": "brainrot",
                      "found": true,
                      "term": {
                        "term": "Brainrot",
                        "definition": "Internet slang for content so low-value or repetitive it's said to rot the viewer's brain.",
                        "category": "slang",
                        "velocityIndex": "12.5%",
                        "decayTracker": {
                          "cringeStatus": "Rising",
                          "decayIndex": 0.42
                        },
                        "originMapping": [
                          {
                            "platform": "tiktok",
                            "stage": "Origin",
                            "date": "2023-06-01"
                          }
                        ],
                        "templateData": {
                          "name": "slang term",
                          "status": "Established",
                          "viralPreferenceScore": 74
                        },
                        "relatedSlugs": [
                          "skibidi-toilet",
                          "gyatt"
                        ]
                      }
                    },
                    {
                      "slug": "not-a-real-term",
                      "found": false
                    }
                  ],
                  "meta": {
                    "requested": 2,
                    "found": 1
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid body — missing slugs, more than 20 items, or a malformed slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INVALID_INPUT",
                    "message": "Invalid request parameters.",
                    "status": 400
                  },
                  "issues": [
                    {
                      "field": "slugs",
                      "message": "slugs must contain 20 items or fewer"
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "UNAUTHORIZED",
                    "message": "Invalid API key.",
                    "status": 401
                  }
                }
              }
            }
          },
          "429": {
            "description": "Burst rate limit or monthly quota exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "RATE_LIMITED",
                    "message": "Rate limit exceeded. Please slow down and try again shortly.",
                    "status": 429
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error — safe to retry.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "INTERNAL_ERROR",
                    "message": "Something went wrong. Please try again.",
                    "status": 500
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "cg_live_...",
        "description": "Pass your API key as a bearer token: `Authorization: Bearer cg_live_...`. Get a key at /pricing."
      }
    },
    "schemas": {
      "DecayTracker": {
        "type": "object",
        "properties": {
          "cringeStatus": {
            "type": "string",
            "enum": [
              "Oversaturated",
              "Rising",
              "Fresh"
            ]
          },
          "decayIndex": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "cringeStatus",
          "decayIndex"
        ]
      },
      "OriginMappingPoint": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string"
          },
          "stage": {
            "type": "string",
            "enum": [
              "Origin",
              "Active",
              "Current"
            ]
          },
          "date": {
            "type": "string"
          }
        },
        "required": [
          "platform",
          "stage",
          "date"
        ]
      },
      "TemplateData": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "Established",
              "Emerging"
            ]
          },
          "viralPreferenceScore": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "name",
          "status",
          "viralPreferenceScore"
        ]
      },
      "TermData": {
        "type": "object",
        "properties": {
          "term": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "meme",
              "slang",
              "trend",
              "brainrot",
              "event",
              "creator"
            ]
          },
          "velocityIndex": {
            "type": "string",
            "example": "12.5%"
          },
          "decayTracker": {
            "$ref": "#/components/schemas/DecayTracker"
          },
          "originMapping": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OriginMappingPoint"
            }
          },
          "templateData": {
            "$ref": "#/components/schemas/TemplateData"
          },
          "relatedSlugs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "term",
          "definition",
          "category",
          "velocityIndex",
          "decayTracker",
          "originMapping",
          "templateData",
          "relatedSlugs"
        ]
      },
      "TermResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "$ref": "#/components/schemas/TermData"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "ErrorDetail": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "RATE_LIMITED"
          },
          "message": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          }
        },
        "required": [
          "code",
          "message",
          "status"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ]
      },
      "ValidationErrorResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ErrorResponse"
          },
          {
            "type": "object",
            "properties": {
              "issues": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "message"
                  ]
                }
              }
            }
          }
        ]
      },
      "EntryScores": {
        "type": "object",
        "properties": {
          "relevance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "influence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "cringe": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "brainrot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "relevance",
          "influence",
          "cringe",
          "brainrot"
        ]
      },
      "TermSummary": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "term": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "meme",
              "slang",
              "trend",
              "brainrot",
              "event",
              "creator"
            ]
          },
          "description": {
            "type": "string"
          },
          "scores": {
            "$ref": "#/components/schemas/EntryScores"
          },
          "velocity": {
            "type": [
              "number",
              "null"
            ],
            "description": "Latest recorded velocity, or null if this entry has no recorded history yet."
          }
        },
        "required": [
          "slug",
          "term",
          "category",
          "description",
          "scores",
          "velocity"
        ]
      },
      "TermsListResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TermSummary"
            }
          },
          "pagination": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer"
              },
              "limit": {
                "type": "integer"
              },
              "total": {
                "type": "integer"
              },
              "totalPages": {
                "type": "integer"
              }
            },
            "required": [
              "page",
              "limit",
              "total",
              "totalPages"
            ]
          }
        },
        "required": [
          "success",
          "data",
          "pagination"
        ]
      },
      "BatchTermsRequest": {
        "type": "object",
        "properties": {
          "slugs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "maxLength": 120
            }
          }
        },
        "required": [
          "slugs"
        ]
      },
      "BatchTermsResultItem": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "found": {
            "type": "boolean"
          },
          "term": {
            "$ref": "#/components/schemas/TermData"
          }
        },
        "required": [
          "slug",
          "found"
        ],
        "description": "`term` is present only when `found` is true."
      },
      "BatchTermsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BatchTermsResultItem"
            }
          },
          "meta": {
            "type": "object",
            "properties": {
              "requested": {
                "type": "integer"
              },
              "found": {
                "type": "integer"
              }
            },
            "required": [
              "requested",
              "found"
            ]
          }
        },
        "required": [
          "success",
          "data",
          "meta"
        ]
      }
    }
  }
}
